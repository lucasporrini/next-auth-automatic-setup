  "author": "Lucas PORRINI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasporrini/next-auth-automatic-setup.git"
  },
  "bugs": {
    "url": "https://github.com/lucasporrini/next-auth-automatic-setup/issues"
  },
  "homepage": "https://github.com/lucasporrini/next-auth-automatic-setup#readme",
  "dependencies": {
    "child_process": "^1.0.2",
    "fs-extra": "^11.2.0",
    "inquirer": "^11.0.2",
    "next-auth": "^5.0.0-beta.18"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.7.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
